          "span_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "trace_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Logs": {
        "type": "object",
        "description": "Log lines, newest first.",
        "required": [
          "logs",
          "truncated",
          "unindexed"

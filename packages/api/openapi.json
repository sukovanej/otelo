          "sql": {
            "type": "string",
            "description": "One `SELECT`. It reads the views `resources`, `logs`, `spans`,\n`series`, `points`, `attribute_keys`, and `attribute_values`, which\njoin the day files with a `day` column in front, or the tables of one\nday as `\"2026-09-28\".logs`."
          },
          "until": {
            "type": [
              "string",
              "null"
            ],
            "description": "The end of the range, in the form of `since`. Now when missing."

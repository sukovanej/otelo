          "scanned": {
            "type": "integer",
            "format": "int64",
            "description": "How many lines the groups count.",
            "minimum": 0
          },
          "truncated": {
            "type": "boolean",
            "description": "More groups exist than the limit let through."
          },
          "unindexed": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The attributes the query compares that have no index."
          }
        }
      },
      "LogLine": {
        "type": "object",

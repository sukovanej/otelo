          "services": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "severity": {
            "type": "integer",
            "format": "int32",
            "description": "The highest severity number in the group."
          },
          "template": {
            "type": "string",
            "description": "The body with numbers, UUIDs, hex IDs, and quoted strings replaced by\nplaceholders."
          }
        }
      },
      "LogGroups": {
        "type": "object",
        "description": "Log lines grouped by message template, the largest group first.",

{
  "openapi": "3.1.0",
  "info": {
    "title": "siner",
    "description": "Query the logs, traces, and metrics that siner keeps.",
    "license": {
      "name": ""
    },
    "version": "0.0.1"
  },
  "paths": {
    "/api/attributes": {
      "get": {
        "summary": "The attribute keys of the records of a signal and of their resources over\nthe retention, the most common first, with their types.",
        "operationId": "attributes",
        "parameters": [
          {
            "name": "signal",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Signal"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attributes"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/complete": {
      "get": {
        "summary": "Suggests the fields, operators, values, and keywords that can go at the\ncursor of a query, from the attributes and values of the retention.",
        "operationId": "complete",
        "parameters": [
          {
            "name": "signal",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Signal"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "The query as typed so far.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "The position of the cursor in the query, in characters. The end of the\nquery when missing.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Completions"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/indexes": {
      "get": {
        "summary": "The attributes that have an index.",
        "operationId": "list_indexes",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexList"
                }
              }
            }
          }
        }
      }
    },
    "/api/indexes/{signal}/{key}": {
      "put": {
        "summary": "Indexes an attribute of the logs or of the spans in every day file, so a\nquery that compares it reads only the matching records. The writer builds\nthe index within seconds.",
        "operationId": "add_index",
        "parameters": [
          {
            "name": "signal",
            "in": "path",
            "description": "`logs` or `spans`",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Signal"
            }
          },
          {
            "name": "key",
            "in": "path",
            "description": "The attribute key, such as `user.id`",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexList"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Drops the index of an attribute from every day file.",
        "operationId": "remove_index",
        "parameters": [
          {
            "name": "signal",
            "in": "path",
            "description": "`logs` or `spans`",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Signal"
            }
          },
          {
            "name": "key",
            "in": "path",
            "description": "The attribute key, such as `user.id`",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexList"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/logs": {
      "get": {
        "summary": "Log lines, newest first.",
        "operationId": "logs",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "description": "The start of the range: a duration before now, such as `1h`, or an\nRFC 3339 timestamp. One hour before `until` when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "until",
            "in": "query",
            "description": "The end of the range, in the form of `since`. Now when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "The most rows to return.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "The records to keep, such as `http.route = \"/matches\" OR user.id = 7`.\nEvery record when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Logs"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/logs/groups": {
      "get": {
        "summary": "Log lines grouped by message template, the largest group first. The\ntemplate replaces numbers, UUIDs, hex IDs, and quoted strings with\nplaceholders.",
        "operationId": "log_groups",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "description": "The start of the range: a duration before now, such as `1h`, or an\nRFC 3339 timestamp. One hour before `until` when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "until",
            "in": "query",
            "description": "The end of the range, in the form of `since`. Now when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "The most rows to return.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "The records to keep, such as `http.route = \"/matches\" OR user.id = 7`.\nEvery record when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogGroups"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "summary": "The series that have points in the range and that the query keeps, by\nname. The query reads `name`, `service`, `kind`, `unit`, the labels, and\nthe resource.",
        "operationId": "metrics",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "description": "The start of the range: a duration before now, such as `1h`, or an\nRFC 3339 timestamp. One hour before `until` when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "until",
            "in": "query",
            "description": "The end of the range, in the form of `since`. Now when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "The most rows to return.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "The records to keep, such as `http.route = \"/matches\" OR user.id = 7`.\nEvery record when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricList"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics/{name}": {
      "get": {
        "summary": "The series of one metric, each in buckets of one step with the count, the\nminimum, the average, the maximum, and the last value.",
        "operationId": "metric",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "The name of the metric",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "The start of the range: a duration before now, such as `1h`, or an\nRFC 3339 timestamp. One hour before `until` when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "until",
            "in": "query",
            "description": "The end of the range, in the form of `since`. Now when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "The most series to return.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "The series to keep, by their labels and resource, such as\n`state = used`. Every series of the metric when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "step",
            "in": "query",
            "description": "The length of a bucket, such as `1m`. One that makes 120 buckets at\nmost when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricSeries"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/spans": {
      "get": {
        "summary": "Spans, newest first.",
        "operationId": "spans",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "description": "The start of the range: a duration before now, such as `1h`, or an\nRFC 3339 timestamp. One hour before `until` when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "until",
            "in": "query",
            "description": "The end of the range, in the form of `since`. Now when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "The most rows to return.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "The records to keep, such as `http.route = \"/matches\" OR user.id = 7`.\nEvery record when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Spans"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/sql": {
      "post": {
        "summary": "Runs a read-only SQL query over the day files of the range.",
        "operationId": "sql",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SqlRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SqlResult"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/traces": {
      "get": {
        "summary": "Traces with a span that the query keeps, by their root span, newest first.",
        "operationId": "traces",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "description": "The start of the range: a duration before now, such as `1h`, or an\nRFC 3339 timestamp. One hour before `until` when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "until",
            "in": "query",
            "description": "The end of the range, in the form of `since`. Now when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "The most rows to return.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "The records to keep, such as `http.route = \"/matches\" OR user.id = 7`.\nEvery record when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Traces"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/traces/{trace_id}": {
      "get": {
        "summary": "One trace: its spans by start time, and the logs that carry its ID.",
        "operationId": "trace",
        "parameters": [
          {
            "name": "trace_id",
            "in": "path",
            "description": "The trace ID as 32 hex digits",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "The start of the range: a duration before now, such as `1h`, or an\nRFC 3339 timestamp. The whole retention when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "until",
            "in": "query",
            "description": "The end of the range, in the form of `since`. Now when missing.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "The most spans, and the most logs, to return.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trace"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Attribute": {
        "type": "object",
        "required": [
          "key",
          "type",
          "count",
          "indexed"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int64",
            "description": "How many records have the key. For resources and series, how many\nresources and series.",
            "minimum": 0
          },
          "indexed": {
            "type": "boolean",
            "description": "Whether the key has an index."
          },
          "key": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "The JSON type of the values: `string`, `int`, `float`, `bool`,\n`array`, `object`, or `mixed`."
          }
        }
      },
      "Attributes": {
        "type": "object",
        "description": "The attribute keys of a signal, over the attached days.",
        "required": [
          "record",
          "resource"
        ],
        "properties": {
          "record": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attribute"
            },
            "description": "The attributes of the records: of the logs, the spans, or the labels\nof the series."
          },
          "resource": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attribute"
            },
            "description": "The attributes of the resources that sent them."
          }
        }
      },
      "Bucket": {
        "type": "object",
        "description": "The points of one series in one step.",
        "required": [
          "time",
          "count",
          "min",
          "max",
          "avg",
          "last",
          "histogram"
        ],
        "properties": {
          "avg": {
            "type": "number",
            "format": "double"
          },
          "count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "histogram": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Distribution",
                "description": "The values a histogram recorded in the step: the counts of its\nbuckets and percentile estimates. `None` for a gauge or a sum, and for\nthe first step of a cumulative histogram, which only sets where the\ncounting starts."
              }
            ]
          },
          "last": {
            "type": "number",
            "format": "double",
            "description": "The value of the newest point."
          },
          "max": {
            "type": "number",
            "format": "double"
          },
          "min": {
            "type": "number",
            "format": "double"
          },
          "time": {
            "type": "string",
            "format": "date-time",
            "description": "The start of the bucket."
          }
        }
      },
      "CompletionKind": {
        "type": "string",
        "description": "What the text of a suggestion is.",
        "enum": [
          "field",
          "operator",
          "value",
          "keyword"
        ]
      },
      "Completions": {
        "type": "object",
        "description": "What can go at the cursor of a query.",
        "required": [
          "suggestions"
        ],
        "properties": {
          "suggestions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SuggestionBody"
            }
          }
        }
      },
      "Distribution": {
        "type": "object",
        "description": "The values a histogram series recorded in one time step: its points\nmerged, with the increases of cumulative points.",
        "required": [
          "bounds",
          "counts",
          "count",
          "sum",
          "p50",
          "p90",
          "p99"
        ],
        "properties": {
          "bounds": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "description": "The upper bounds of the buckets. The last bucket has no upper bound."
          },
          "count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "counts": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          "p50": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Estimates of the median and the 90th and 99th percentiles, by linear\ninterpolation inside a bucket. `None` without values."
          },
          "p90": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "p99": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "sum": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "The body of every error response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "IndexBody": {
        "type": "object",
        "required": [
          "signal",
          "key"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "signal": {
            "$ref": "#/components/schemas/Signal",
            "description": "`logs` or `spans`."
          }
        }
      },
      "IndexList": {
        "type": "object",
        "description": "The attributes that have an index.",
        "required": [
          "indexes"
        ],
        "properties": {
          "indexes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IndexBody"
            }
          }
        }
      },
      "LogGroup": {
        "type": "object",
        "required": [
          "template",
          "count",
          "severity",
          "level",
          "services",
          "first",
          "last",
          "samples"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "first": {
            "type": "string",
            "format": "date-time"
          },
          "last": {
            "type": "string",
            "format": "date-time"
          },
          "level": {
            "type": "string"
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Up to three different bodies, newest first."

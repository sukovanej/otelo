            "type": "object",
            "description": "The attributes of the resource that sent the span.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "service": {
            "type": "string"
          },
          "span_id": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32",

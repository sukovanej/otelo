          "resource": {
            "type": "object",
            "description": "The attributes of the resource that sent the line.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "service": {
            "type": "string"
          },
          "severity": {
            "type": "integer",
            "format": "int32",
            "description": "The OpenTelemetry severity number."
          },
          "source": {
            "type": "string",
            "description": "`otlp`, or the service log source that read the line."

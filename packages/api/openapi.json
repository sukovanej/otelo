          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "trace_id": {
            "type": "string"
          }
        }
      },
      "TraceSummary": {
        "type": "object",
        "required": [
          "trace_id",
          "time",
          "service",
          "name",
          "kind",
          "duration_ns",
          "spans",
          "error",
          "attributes",
          "resource"
        ],
        "properties": {
